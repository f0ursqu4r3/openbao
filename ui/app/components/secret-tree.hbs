<nav class="secret-tree" aria-label="Folders" data-test-secret-tree>
  <ul class="secret-tree__list is-root">
    <SecretTree::Node
      @backend={{@backend}}
      @modelType={{@modelType}}
      @path=""
      @name={{concat @backend "/"}}
      @currentPath={{or @currentPath ""}}
      @isRoot={{true}}
    />
  </ul>
</nav>