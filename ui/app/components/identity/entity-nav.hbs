<PageHeader as |header|>
  <header.levelLeft>
    <div>
      <h1 class="title is-3">
        {{capitalize (pluralize this.identityType)}}
      </h1>
      <p class="page-subtitle">
        {{#if (eq this.identityType "entity")}}
          An entity is one user or machine. Aliases link it to its logins on each auth method.
        {{else}}
          A group collects entities and other groups so that they share policies.
        {{/if}}
      </p>
    </div>
  </header.levelLeft>
  <header.levelRight>
    <div class="page-header-actions">
      {{#if (eq this.identityType "entity")}}
        <Hds::Button
          @text="Merge {{pluralize this.identityType}}"
          @color="secondary"
          @route="vault.cluster.access.identity.merge"
          @model={{pluralize this.identityType}}
          data-test-entity-merge-link={{true}}
        />
      {{/if}}
      <Hds::Button
        @text="Create {{this.identityType}}"
        @icon="plus"
        @route="vault.cluster.access.identity.create"
        @model={{pluralize this.identityType}}
        data-test-entity-create-link={{true}}
      />
    </div>
  </header.levelRight>
</PageHeader>
<div class="tabs-container box is-sideless is-fullwidth is-paddingless is-marginless">
  <nav class="tabs">
    <ul>
      <LinkTo @route="vault.cluster.access.identity.index" @model={{pluralize this.identityType}}>
        {{capitalize (pluralize this.identityType)}}
      </LinkTo>
      <LinkTo @route="vault.cluster.access.identity.aliases.index" @model={{pluralize this.identityType}}>
        Aliases
      </LinkTo>
    </ul>
  </nav>
</div>
{{#if this.model.meta.total}}
  <Toolbar>
    <ToolbarFilters>
      <Identity::LookupInput @type={{this.identityType}} />
    </ToolbarFilters>
  </Toolbar>
{{/if}}