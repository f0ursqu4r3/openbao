<PageHeader as |header|>
  <header.levelLeft>
    <div>
      <h1 class="title is-3">
        Multi-factor authentication
      </h1>
      <p class="page-subtitle">
        Configure and enforce multi-factor authentication (MFA) for users logging into OpenBao, for any authentication
        method.
        {{! TODO Add a link to a tutorial for 'auth-methods/multi-factor-authentication' }}
      </p>
    </div>
  </header.levelLeft>
  <header.levelRight>
    <Hds::Button @text="Configure MFA" @route="vault.cluster.access.mfa.methods.create" data-test-mfa-configure />
  </header.levelRight>
</PageHeader>

<div class="stat-cards">
  <div class="stat-card">
    <Icon @name="shield-check" @size="24" class="stat-card__icon" />
    <div>
      <div class="stat-card__label">Step 1</div>
      <p>Set up an MFA configuration using one of the methods; TOTP, Okta, Duo or Pingid.</p>
    </div>
  </div>
  <div class="stat-card">
    <Icon @name="user-check" @size="24" class="stat-card__icon" />
    <div>
      <div class="stat-card__label">Step 2</div>
      <p>Set up an enforcement to map the MFA configuration to your chosen auth method(s).</p>
    </div>
  </div>
</div>

{{! the diagram is an image with dark text on a transparent background, so it needs a light panel }}
<div class="diagram-panel">
  <img src={{img-path "~/mfa-landing.png"}} alt="MFA configure diagram" />
</div>