{{#if (or (eq this.policyType "acl"))}}
  <PageHeader as |header|>
    <header.levelLeft>
      <div>
        <h1 class="title is-3">
          {{uppercase this.policyType}}
          Policies
        </h1>
        <p class="page-subtitle">Define which paths a token can read, write, and manage.</p>
      </div>
    </header.levelLeft>
    <header.levelRight>
      <Hds::Button
        @text="Create {{uppercase this.policyType}} policy"
        @icon="plus"
        @route="vault.cluster.policies.create"
        data-test-policy-create-link
      />
    </header.levelRight>
  </PageHeader>
  <Toolbar>
    {{#if this.model.meta.total}}
      <ToolbarFilters>
        <NavigateInput
          @filterFocusDidChange={{action "setFilterFocus"}}
          @filterDidChange={{action "setFilter"}}
          @filter={{this.filter}}
          @filterMatchesKey={{this.filterMatchesKey}}
          @firstPartialMatch={{this.firstPartialMatch}}
          @extraNavParams={{this.policyType}}
          @placeholder="Filter policies"
          @mode="policy"
        />
        {{#if this.filterFocused}}
          {{#if this.filterMatchesKey}}
            <p class="input-hint">
              <kbd>ENTER</kbd>
              to go to
              <code>{{or this.pageFilter this.filter}}</code>
            </p>
          {{/if}}
          {{#if this.firstPartialMatch}}
            <p class="input-hint">
              <kbd>TAB</kbd>
              to complete
              <code>{{this.firstPartialMatch.id}}</code>
            </p>
          {{/if}}
        {{/if}}
      </ToolbarFilters>
    {{/if}}
  </Toolbar>
  {{#if this.model.meta.total}}
    <div class="engine-table engine-table--policies">
      <div class="engine-table__head" aria-hidden="true">
        <span>Name</span>
        <span>Notes</span>
        <span></span>
      </div>
      {{#each this.model as |item|}}
        {{#if (eq item.id "root")}}
          <div class="list-item-row engine-table__row is-static" data-test-policy-item>
            <div class="engine-table__path">
              <Icon @name="file" class="has-text-grey-light" />
              <span class="has-text-weight-semibold has-text-grey" data-test-policy-name>
                {{item.id}}
              </span>
            </div>
            <p class="has-text-grey">
              The
              <code>root</code>
              policy does not contain any rules but can do anything within OpenBao. It should be used with extreme care.
            </p>
          </div>
        {{else}}
          <LinkedBlock
            @params={{array "vault.cluster.policy.show" this.policyType item.id}}
            class="list-item-row engine-table__row is-no-underline"
            data-test-policy-link={{item.id}}
          >
            <LinkTo
              @route="vault.cluster.policy.show"
              @models={{array this.policyType item.id}}
              class="engine-table__path has-text-black has-text-weight-semibold"
              data-test-policy-item={{true}}
            >
              <Icon @name="file" class="has-text-grey-light" />
              <span data-test-policy-name>{{item.id}}</span>
            </LinkTo>
            <div class="has-text-grey">
              {{#if (eq item.id "default")}}
                Attached to every token unless you exclude it.
              {{/if}}
            </div>
            <div class="linkable-item-menu">
              <PopupMenu name="policy-nav">
                <Confirm as |c|>
                  <nav class="menu">
                    <ul class="menu-list">
                      {{#if item.updatePath.isPending}}
                        <li class="action">
                          <button disabled type="button" class="link button is-loading is-transparent">
                            loading
                          </button>
                        </li>
                        <li class="action">
                          <button disabled type="button" class="link button is-loading is-transparent">
                            loading
                          </button>
                        </li>
                      {{else}}
                        {{#if item.canRead}}
                          <li class="action">
                            <LinkTo
                              @route="vault.cluster.policy.show"
                              @models={{array this.policyType item.id}}
                              data-test-policy-link="show"
                            >
                              Details
                            </LinkTo>
                          </li>
                        {{/if}}
                        {{#if item.canEdit}}
                          <li class="action">
                            <LinkTo
                              @route="vault.cluster.policy.edit"
                              @models={{array this.policyType item.id}}
                              data-test-policy-link="edit"
                            >
                              Edit
                            </LinkTo>
                          </li>
                        {{/if}}
                        {{#if item.canDelete}}
                          <li class="action">
                            <c.Message
                              @id={{item.id}}
                              @confirmMessage="This will permanently delete this policy and may affect access to some data"
                              @onConfirm={{action "deletePolicy" item}}
                              data-test-policy-delete={{item.id}}
                            />
                          </li>
                        {{/if}}
                      {{/if}}
                    </ul>
                  </nav>
                </Confirm>
              </PopupMenu>
            </div>
          </LinkedBlock>
        {{/if}}
      {{else}}
        <div class="engine-table__empty has-text-grey">No policies matching &quot;{{this.pageFilter}}&quot;</div>
      {{/each}}
    </div>
    {{#if (gt this.model.meta.lastPage 1)}}
      <ListPagination
        @page={{this.model.meta.currentPage}}
        @lastPage={{this.model.meta.lastPage}}
        @link="vault.cluster.policies.index"
      />
    {{/if}}
  {{else}}
    <EmptyState
      @title="No {{uppercase this.policyType}} policies yet"
      @message="A list of policies will be listed here. Create your first {{uppercase
        this.policyType
      }} policy to get started."
    >
      <LinkTo @route="vault.cluster.policies.create" class="link">
        Create
        {{uppercase this.policyType}}
        policy
        <Chevron />
      </LinkTo>
      {{! TODO Add a link to a tutorial for 'getting-started/getting-started-policies' }}
    </EmptyState>
  {{/if}}
{{/if}}