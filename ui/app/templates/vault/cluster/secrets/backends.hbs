<PageHeader as |header|>
  <header.levelLeft>
    <div>
      <h1 class="title is-3">
        Secrets Engines
      </h1>
      <p class="page-subtitle">Mount, configure, and browse the backends that store and generate secrets.</p>
    </div>
  </header.levelLeft>
  <header.levelRight>
    <Hds::Button
      @text="Enable new engine"
      @icon="plus"
      @route="vault.cluster.settings.mount-secret-backend"
      data-test-enable-engine
    />
  </header.levelRight>
</PageHeader>

<div class="stat-cards" data-test-engine-stats>
  <div class="stat-card">
    <Icon @name="key-values" @size="24" class="stat-card__icon" />
    <div>
      <div class="stat-card__label">Mounted engines</div>
      <div class="stat-card__value" data-test-engine-stat="mounted">{{this.displayableBackends.length}}</div>
    </div>
  </div>
  <div class="stat-card">
    <Icon @name="layers" @size="24" class="stat-card__icon" />
    <div>
      <div class="stat-card__label">Engine types</div>
      <div class="stat-card__value" data-test-engine-stat="types">{{this.engineTypeCount}}</div>
    </div>
  </div>
  {{#if this.cluster}}
    <div class="stat-card">
      <Icon @name={{if this.cluster.sealed "lock" "unlock"}} @size="24" class="stat-card__icon" />
      <div>
        <div class="stat-card__label">Seal status</div>
        <div class="stat-card__value">{{if this.cluster.sealed "Sealed" "Unsealed"}}</div>
        {{#if this.cluster.sealType}}
          <div class="stat-card__detail">{{this.cluster.sealType}} seal</div>
        {{/if}}
      </div>
    </div>
    <div class="stat-card">
      <Icon @name="hard-drive" @size="24" class="stat-card__icon" />
      <div>
        <div class="stat-card__label">Storage</div>
        <div class="stat-card__value">{{or this.cluster.storageType "Unknown"}}</div>
        {{#if this.cluster.leaderNode.version}}
          <div class="stat-card__detail">OpenBao {{this.cluster.leaderNode.version}}</div>
        {{/if}}
      </div>
    </div>
  {{/if}}
</div>

<Toolbar>
  <ToolbarFilters>
    <SearchSelect
      @id="filter-by-engine-type"
      @options={{this.secretEngineArrayByType}}
      @selectLimit="1"
      @disallowNewItems={{true}}
      @fallbackComponent="input-search"
      @onChange={{this.filterEngineType}}
      @placeholder={{"Filter by engine type"}}
      @displayInherit={{true}}
      @inputValue={{if this.selectedEngineType (array this.selectedEngineType)}}
      @disabled={{if this.selectedEngineName true false}}
      class="is-marginless"
    />
    <SearchSelect
      @id="filter-by-engine-name"
      @options={{this.secretEngineArrayByName}}
      @selectLimit="1"
      @disallowNewItems={{true}}
      @fallbackComponent="input-search"
      @onChange={{this.filterEngineName}}
      @placeholder={{"Filter by engine name"}}
      @displayInherit={{true}}
      @inputValue={{if this.selectedEngineName (array this.selectedEngineName)}}
      class="is-marginless has-left-padding-s"
    />
    <span class="is-marginless has-left-padding-xs">
      <Toggle
        @name="show-internal-engines"
        @status="success"
        @size="small"
        @checked={{this.showInternalEngines}}
        @onChange={{this.toggleShowInternalEngines}}
        data-test-show-internal-engines-toggle
      >
        <span class="has-text-grey">Show internal engines</span>
      </Toggle>
    </span>
  </ToolbarFilters>
</Toolbar>

<div class="engine-layout {{if this.detailEngine 'has-detail'}}">
  <div class="engine-table">
    <div class="engine-table__head" aria-hidden="true">
      <span>Path</span>
      <span>Type</span>
      <span class="engine-table__optional">Accessor</span>
      <span>Default TTL</span>
      <span class="engine-table__optional">Description</span>
      <span></span>
      <span></span>
    </div>
    {{#each this.sortedDisplayableBackends as |backend|}}
      <LinkedBlock
        @params={{array backend.backendLink backend.id}}
        class="list-item-row engine-table__row is-no-underline"
        data-test-auth-backend-link={{backend.id}}
        @disabled={{if backend.isSupportedBackend false true}}
      >
        <div class="engine-table__path" data-test-linkable-item-content>
          {{#if backend.icon}}
            <Icon @name={{backend.icon}} class="has-text-grey-light" data-test-linkable-item-glyph />
          {{/if}}
          {{#if backend.path}}
            {{#if backend.isSupportedBackend}}
              <LinkTo
                @route={{backend.backendLink}}
                @model={{backend.id}}
                class="has-text-black has-text-weight-semibold"
                data-test-secret-path
              >
                {{backend.path}}
              </LinkTo>
            {{else}}
              <span data-test-secret-path>{{backend.path}}</span>
            {{/if}}
          {{/if}}
        </div>
        <div>
          <span class="tag">{{or backend.engineType backend.path}}</span>
        </div>
        <div class="engine-table__optional">
          {{#if backend.accessor}}
            <code class="has-text-grey is-size-8" data-test-linkable-item-accessor>
              {{backend.accessor}}
            </code>
          {{/if}}
        </div>
        <div class="has-text-grey">
          {{or (format-duration backend.config.defaultLeaseTtl) "System default"}}
        </div>
        <div class="engine-table__optional engine-table__description has-text-grey" data-test-linkable-item-description>
          {{backend.description}}
        </div>
        <button
          type="button"
          class="engine-table__detail-button {{if (eq this.detailEngine.id backend.id) 'is-active'}}"
          aria-label="Show details for {{backend.path}}"
          aria-pressed={{if (eq this.detailEngine.id backend.id) "true" "false"}}
          title="Details"
          data-test-engine-detail-toggle={{backend.id}}
          {{on "click" (fn this.showDetails backend)}}
        >
          <Icon @name="sidebar-show" />
        </button>
        {{! meatball sandwich menu }}
        <div class="linkable-item-menu" data-test-linkable-item-menu={{backend.path}}>
          <PopupMenu @name="engine-menu">
            <Confirm as |c|>
              <nav class="menu" aria-label="{{if backend.isSupportedBackend 'supported' 'unsupported'}} secrets engine menu">
                <ul class="menu-list">
                  <li class="action">
                    <LinkTo
                      @route="vault.cluster.secrets.backend.configuration"
                      @model={{backend.id}}
                      data-test-engine-config
                    >
                      View configuration
                    </LinkTo>
                  </li>
                  {{#if (not-eq backend.type "cubbyhole")}}
                    <li class="action">
                      <c.Message
                        @id={{backend.id}}
                        @triggerText="Disable"
                        @message="Any data in this engine will be permanently deleted."
                        @title="Disable engine?"
                        @confirmButtonText="Disable"
                        @onConfirm={{perform this.disableEngine backend}}
                        data-test-engine-disable="true"
                      />
                    </li>
                  {{/if}}
                </ul>
              </nav>
            </Confirm>
          </PopupMenu>
        </div>
      </LinkedBlock>
    {{else}}
      <div class="engine-table__empty has-text-grey">No secrets engines match the filters.</div>
    {{/each}}
  </div>
  {{#if this.detailEngine}}
    <aside class="engine-detail" aria-label="Engine details" data-test-engine-detail>
      <div class="engine-detail__header">
        <Icon @name={{or this.detailEngine.icon "key-values"}} @size="24" class="stat-card__icon" />
        <div class="engine-detail__title">
          <h2 class="title is-5" data-test-engine-detail-path>{{this.detailEngine.path}}</h2>
          <span class="engine-detail__type">
            {{this.detailEngine.engineType}}{{#if this.detailEngine.version}} · version {{this.detailEngine.version}}{{/if}}
          </span>
        </div>
        <button
          type="button"
          class="engine-detail__close"
          aria-label="Close details"
          data-test-engine-detail-close
          {{on "click" this.closeDetails}}
        >
          <Icon @name="x" />
        </button>
      </div>
      <dl class="engine-detail__list">
        <dt>Path</dt>
        <dd>{{this.detailEngine.path}}</dd>
        <dt>Type</dt>
        <dd>{{this.detailEngine.engineType}}</dd>
        <dt>Accessor</dt>
        <dd><code data-test-engine-detail-accessor>{{this.detailEngine.accessor}}</code></dd>
        {{#if this.detailEngine.version}}
          <dt>Version</dt>
          <dd>{{this.detailEngine.version}}</dd>
        {{/if}}
        <dt>Default TTL</dt>
        <dd>{{or (format-duration this.detailEngine.config.defaultLeaseTtl) "System default"}}</dd>
        <dt>Max TTL</dt>
        <dd>{{or (format-duration this.detailEngine.config.maxLeaseTtl) "System default"}}</dd>
        <dt>Description</dt>
        <dd>{{or this.detailEngine.description "None"}}</dd>
      </dl>
      <div class="engine-detail__actions">
        {{#if this.detailEngine.isSupportedBackend}}
          <Hds::Button
            @text="Open engine"
            @size="small"
            @route={{this.detailEngine.backendLink}}
            @model={{this.detailEngine.id}}
            data-test-engine-detail-open
          />
        {{/if}}
        <Hds::Button
          @text="View configuration"
          @size="small"
          @color="secondary"
          @route="vault.cluster.secrets.backend.configuration"
          @model={{this.detailEngine.id}}
          data-test-engine-detail-config
        />
      </div>
    </aside>
  {{/if}}
</div>